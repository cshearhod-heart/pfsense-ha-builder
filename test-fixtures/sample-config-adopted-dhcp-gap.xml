<?xml version="1.0"?>
<!-- Synthetic pfSense config.xml: primary that ALREADY has CARP + hasync configured
     (e.g. HA was set up previously, or on one interface, and a secondary needs building
     to match). All IPs, credentials, and identifiers are fake. -->
<pfsense>
	<version>24.6</version>
	<system>
		<hostname>fw-existing-ha</hostname>
		<domain>lab.internal</domain>
		<dhcpbackend>isc</dhcpbackend>
	</system>
	<interfaces>
		<wan>
			<if>igb0</if>
			<descr>WAN</descr>
			<enable></enable>
			<ipaddr>203.0.113.10</ipaddr>
			<subnet>29</subnet>
			<gateway>WANGW</gateway>
		</wan>
		<lan>
			<if>igb1</if>
			<descr>LAN</descr>
			<enable></enable>
			<ipaddr>10.10.10.2</ipaddr>
			<subnet>24</subnet>
		</lan>
		<opt1>
			<if>igb2</if>
			<descr>SYNC</descr>
			<enable></enable>
			<ipaddr>10.255.255.1</ipaddr>
			<subnet>30</subnet>
		</opt1>
		<opt2>
			<if>igb3</if>
			<descr>SERVER</descr>
			<enable></enable>
			<ipaddr>dhcp</ipaddr>
		</opt2>
		<opt3>
			<if>igb4</if>
			<descr>STORAGE</descr>
			<enable></enable>
			<ipaddr>10.10.20.1</ipaddr>
			<subnet>24</subnet>
		</opt3>
	</interfaces>
	<gateways>
		<gateway_item>
			<interface>wan</interface>
			<gateway>203.0.113.9</gateway>
			<name>WANGW</name>
			<weight>1</weight>
			<ipprotocol>inet</ipprotocol>
			<descr>WAN gateway</descr>
		</gateway_item>
	</gateways>
	<dhcpd>
		<lan>
			<enable></enable>
			<range>
				<from>10.10.10.100</from>
				<to>10.10.10.200</to>
			</range>
			<failover_peerip>10.10.10.3</failover_peerip>
		</lan>
	</dhcpd>
	<unbound>
		<enable></enable>
	</unbound>
	<virtualip>
		<vip>
			<mode>carp</mode>
			<interface>lan</interface>
			<type>single</type>
			<subnet>10.10.10.1</subnet>
			<subnet_bits>24</subnet_bits>
			<descr>CARP - LAN</descr>
			<password>ExistingCarpPass1</password>
			<vhid>7</vhid>
			<advbase>1</advbase>
			<advskew>0</advskew>
			<uniqid>abc123def456</uniqid>
		</vip>
	</virtualip>
	<hasync>
		<pfsyncenabled>on</pfsyncenabled>
		<pfsyncinterface>opt1</pfsyncinterface>
		<pfsyncpeerip>10.255.255.2</pfsyncpeerip>
		<synchronizetoip>10.255.255.2</synchronizetoip>
		<username>admin</username>
		<password>ExistingHaSyncSecret1</password>
		<synchronizerules>on</synchronizerules>
		<synchronizenat>on</synchronizenat>
		<synchronizealiases>on</synchronizealiases>
		<synchronizevirtualip>on</synchronizevirtualip>
		<synchronizeusers>on</synchronizeusers>
		<synchronizecerts>on</synchronizecerts>
		<synchronizedhcpd>on</synchronizedhcpd>
	</hasync>
	<revision>
		<time>1799000000</time>
		<description>Synthetic fixture: primary already has CARP + hasync configured</description>
		<username>admin@lab.internal</username>
	</revision>
</pfsense>
